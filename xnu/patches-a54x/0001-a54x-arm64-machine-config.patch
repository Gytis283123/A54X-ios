+
+
 #ifdef ARM64_BOARD_CONFIG_VMAPPLE
 #include <pexpert/arm64/VMAPPLE.h>
 
diff --git a/osfmk/arm64/proc_reg.h b/osfmk/arm64/proc_reg.h
index 049e55a..beff174 100644
--- a/osfmk/arm64/proc_reg.h
+++ b/osfmk/arm64/proc_reg.h
@@ -251,6 +251,12 @@
 /* D-Cache. */
 #define MMU_CLINE   6
 
+#elif defined (ARM64_BOARD_CONFIG_A54X) /* Samsung Exynos 1380: Cortex-A78 + Cortex-A55 */
